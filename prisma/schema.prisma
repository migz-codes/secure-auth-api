generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An operator of this application.
model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  refresh_tokens RefreshToken[]
}

/// One row per issued refresh token. The row id is the token's `jti` claim, so
/// deleting the row revokes the token — rotation on refresh, logout, and the
/// nightly expiry sweep all work by deleting rows.
model RefreshToken {
  id         String   @id @default(uuid())
  expires_at DateTime
  created_at DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}
