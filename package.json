{
  "name": "secure-auth-api",
  "version": "0.0.1",
  "description": "JWT authentication study project — NestJS, Prisma, access/refresh tokens.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "biome lint && tsc --noEmit",
    "format": "biome check --fix --unsafe",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name",
    "prisma:reset": "prisma migrate reset",
    "docker:test": "docker-compose build --no-cache && docker-compose up",
    "generate:types": "bun run prisma:generate"
  },
  "dependencies": {
    "@nestjs/common": "11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11",
    "@nestjs/schedule": "6.1.1",
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "7.4.1",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.3.1",
    "helmet": "8.3.0",
    "joi": "18.1.2",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.0",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@nestjs/cli": "11",
    "@nestjs/schematics": "11",
    "@nestjs/testing": "11",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.2",
    "@types/node": "22",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.0",
    "jest": "29.5.0",
    "prisma": "7.4.1",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.1.0",
    "ts-loader": "9.4.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      ".+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
